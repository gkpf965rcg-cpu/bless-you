RESEND_API_KEY=
FEEDBACK_FROM_EMAIL=ach000 <onboarding@resend.dev>

# macOS signing / notarisation — never put real secrets in this file or commit them.
# Do not set CSC_NAME or mac.identity to "Developer ID Application: ...".
# electron-builder adds that prefix itself and auto-selects the certificate.
# NOTARYTOOL_PROFILE=ach000-notary
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=
# APPLE_API_KEY=
# APPLE_API_KEY_ID=
# APPLE_API_ISSUER=
